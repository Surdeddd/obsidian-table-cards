{
	"name": "table-cards",
	"version": "0.1.0",
	"description": "Adaptive, all-visible table cards for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:links": "node scripts/check-doc-links.mjs",
		"test": "vitest run",
		"test:tools": "node --test tests-tools/*.test.mjs",
		"test:ui": "playwright test",
		"test:watch": "vitest",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
		"deploy": "node scripts/deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"flashcards",
		"tables"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@playwright/test": "1.62.1",
		"@types/node": "^20.17.0",
		"esbuild": "0.25.5",
		"eslint": "9.30.1",
		"eslint-plugin-obsidianmd": "0.4.1",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^2.1.9"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"allowScripts": {
		"esbuild@0.25.5": true,
		"esbuild@0.21.5": true
	}
}
